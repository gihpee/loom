.env
# Мусор macOS. Лежит в каждом каталоге, куда заглядывали Finder'ом.
.DS_Store
**/.DS_Store
.venv/
dist/
__pycache__/
# Следы сборки пакета из каталога: build/lib — побайтовая копия
# исходников, и заметить в ней настоящую правку невозможно.
build/
*.egg-info/

*.pyc
.pytest_cache/
uv.lock.bak
node_modules/
agent-release.key
web/node_modules/
web/dist/

# Локальные настройки инструментов разработки: у каждого свои порты и свои
# конфигурации запуска, и общими они быть не должны. Если понадобится делить
# настройки на всю команду — исключение добавляется отдельной строкой
# `!.claude/settings.json`, а не открытием всего каталога.
.claude/

# Логи и следы прогонов: появляются от любой команды и ничего не значат для
# следующего, кто откроет репозиторий.
*.log
.ruff_cache/
