# Панель оператора и единственный вход для браузера.
#
# Приложение отдаётся по корню, а /admin и /v1 проксируются в оркестратор.
# Так у API и у SPA не спорят пути, а браузер ходит на один origin — без CORS
# и без адреса оркестратора, зашитого в сборку.
server {
    listen ${LOOMA_WEB_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Single-page app: любой путь, которого нет на диске, отдаёт index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Хеши в именах файлов — можно кэшировать надолго; index.html нельзя,
    # иначе после обновления браузер будет грузить старые скрипты.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Демо на лендинге. Отдельно от /api/ ради одной строчки: без выключенной
    # буферизации nginx копит ответ целиком, и обещанная скорость превращается
    # в паузу на всю генерацию, а потом текст разом. Заодно сюда доезжает адрес
    # обратившегося — по нему считается предел на демо.
    location /api/demo {
        proxy_pass http://${LOOMA_API_HOST}:${LOOMA_HTTP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 300s;
    }

    # Кабинет клиента. Отдельным префиксом от /admin: правило доступа читается
    # по адресу, а не по догадке о том, кто зашёл.
    location /api/ {
        proxy_pass http://${LOOMA_API_HOST}:${LOOMA_HTTP_PORT};
        proxy_set_header Host $host;
        # Сессия ездит в cookie, и без этого заголовка вход работал бы только
        # до первой перезагрузки страницы.
        proxy_set_header Cookie $http_cookie;
        proxy_read_timeout 120s;
    }

    location /admin/ {
        proxy_pass http://${LOOMA_API_HOST}:${LOOMA_HTTP_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Looma-Admin-Token $http_x_looma_admin_token;
        # Результат задачи может быть большим, а установка окружения — долгой.
        client_max_body_size 512m;
        proxy_read_timeout 900s;
    }

    # Канал до Ray-кластера, за которым приходит looma-connect. Здесь важен не
    # proxy_pass, а три строчки про upgrade: без них nginx закрывает
    # рукопожатие WebSocket, и клиент видит обрыв без всякой причины.
    location /connect/ {
        proxy_pass http://${LOOMA_API_HOST}:${LOOMA_HTTP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Looma-Admin-Token $http_x_looma_admin_token;
        # Ray Client держит соединение открытым и подолгу молчит: между двумя
        # вызовами из ноутбука может пройти час, и рвать его нельзя.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }

    location /v1/ {
        proxy_pass http://${LOOMA_API_HOST}:${LOOMA_HTTP_PORT};
        proxy_set_header Host $host;
        # Без этого nginx копит ответ целиком и стрим превращается в паузу на
        # всю генерацию, а потом разом весь текст.
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 900s;
    }
}
