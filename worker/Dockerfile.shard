# Worker image with the multi-stage shard backend (CPU build for testing).
# Production GPU builds use docker/worker.cuda.Dockerfile, which already ships
# torch; here we install a CPU wheel so the pipeline can be exercised anywhere.
FROM python:3.12-slim

WORKDIR /app
COPY pyproject.toml ./
COPY loom_worker ./loom_worker

RUN pip install --no-cache-dir . \
 && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
 && pip install --no-cache-dir transformers safetensors

ENV LOOM_LOG_LEVEL=INFO
ENTRYPOINT ["loom-worker"]
