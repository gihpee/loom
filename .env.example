# =============================================================================
# Looma — конфигурация оркестратора.
#
#   bash scripts/init_env.sh     создаёт .env из этого файла и генерирует секреты
#
# ВАЖНО: комментарии только на отдельных строках. Если написать
# `LOOMA_HTTP_PORT=8000  # порт`, компоуз возьмёт значение вместе с текстом.
# =============================================================================

# --- ПОРТЫ -------------------------------------------------------------------
# Публикуются как <порт>:<порт> — одинаковые внутри и снаружи контейнера.
# Так намеренно: номер порта попадает в join-ключ, и при разных номерах узел
# стучался бы не туда.

# API оркестратора: клиентский /v1 и админский /admin.
LOOMA_HTTP_PORT=8000

# Панель оператора. Отдельный сервис, проксирует API на себя — в браузере
# нужен только этот порт.
LOOMA_WEB_PORT=8080

# Сюда звонят узлы. Единственное соединение, которое они открывают.
LOOMA_GRPC_PORT=9000

# --- АДРЕС ДЛЯ УЗЛОВ ---------------------------------------------------------
# Пусто = определить автоматически (публичный IP -> туннель -> LAN-адрес).
# Задайте явно, если автодетект даёт не то. Порт должен совпадать с GRPC.
#   LOOMA_PUBLIC_ADDR=203.0.113.10:9000
#
# С доменом и TLS здесь обязано быть ИМЯ, а не адрес: сертификат Let's Encrypt
# выписан на домен, и узел, позвонивший по 203.0.113.10, не пройдёт проверку.
#   LOOMA_PUBLIC_ADDR=loomafloat.ru:9000
LOOMA_PUBLIC_ADDR=

# 1 = не спрашивать внешний сервис о публичном IP (закрытый контур)
LOOMA_SKIP_IP_LOOKUP=

# --- ДОСТУП ------------------------------------------------------------------
# Токен для /admin/* (генерируется init_env.sh).
# Пусто = панель и API открыты всем, кто видит порт.
LOOMA_ADMIN_TOKEN=

# --- ХРАНИЛИЩЕ ---------------------------------------------------------------
# Join-ключи и опубликованные релизы агента. Переживает перезапуск.
LOOMA_DATA_DIR=/data

# --- P2P ---------------------------------------------------------------------
# Прямой канал между узлами. Пусто = включён.
# 0 = всё возить через оркестратор (вдвое больше дальних переходов, но работает
# везде).
LOOMA_P2P=

# Circuit-relay для узлов, до которых нельзя дозвониться (docs/P2P_RELAY.md).
# Пусто = адрес берётся из /data/relay/address, куда его кладёт сам relay.
LOOMA_P2P_RELAY=

# ------------------------------------------------------------------ домен и TLS
# Домен, на котором стоит платформа. Он же попадает в сертификат и в ключи
# подключения: сертификат Let's Encrypt выписан на ИМЯ, поэтому узел обязан
# звонить по имени — по адресу вида 203.0.113.7:9000 проверка не пройдёт.
LOOMA_DOMAIN=loomafloat.ru
# Куда Let's Encrypt напишет, если продление перестанет получаться.
LOOMA_ACME_EMAIL=admin@loomafloat.ru

# Сертификат для канала агентов. Задан — канал шифруется; не задан — открыт
# (так работают тесты и локальный запуск). Промежуточного состояния нет
# намеренно: флаг умеет разойтись с действительностью, файлы — нет.
LOOMA_TLS_CERT=/etc/letsencrypt/live/loomafloat.ru/fullchain.pem
LOOMA_TLS_KEY=/etc/letsencrypt/live/loomafloat.ru/privkey.pem

# ---------------------------------------------------------------------- база
# Postgres: учётные записи, сессии, ключи API, дальше — журнал потребления.
LOOMA_DB_NAME=looma
LOOMA_DB_USER=looma
LOOMA_DB_PASSWORD=
LOOMA_DB_PORT=5432
# Пустая строка означает «работать без базы»: тогда доступен только аварийный
# админский токен, а кабинет клиента недоступен целиком.
LOOMA_DATABASE_URL=postgresql://looma:@127.0.0.1:5432/looma
