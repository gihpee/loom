# =============================================================================
# Loom — конфигурация стека.
#
#   bash scripts/init_env.sh     создаёт .env из этого файла и генерирует секреты
#   docker compose -f docker-compose.prod.yml up -d --build
#
# docker compose читает .env сам — экспортировать переменные не нужно.
# ВАЖНО: комментарии только на отдельных строках. Если написать
# `LOOM_HTTP_PORT=8000  # порт`, компоуз возьмёт значение вместе с текстом.
# =============================================================================

# --- ПОРТЫ -------------------------------------------------------------------
# Публикуются как <порт>:<порт> — одинаковые внутри и снаружи контейнера.
# Так сделано намеренно: номер порта попадает в join-ключ воркера, и при разных
# номерах воркер стучался бы не туда. Меняйте, если 8000/9000 заняты.

# OpenAI-совместимый API + админ-панель (/admin/ui)
LOOM_HTTP_PORT=8000

# Control plane + туннель данных: сюда звонят воркеры
LOOM_GRPC_PORT=9000

# --- АДРЕС ДЛЯ ВОРКЕРОВ ------------------------------------------------------
# Пусто = определить автоматически (публичный IP хоста -> туннель -> LAN-адрес).
# Задайте явно, если автодетект даёт не то:
#   LOOM_PUBLIC_ADDR=203.0.113.10:9000
#   LOOM_PUBLIC_ADDR=loom.example.com:9000
# Порт должен совпадать с LOOM_GRPC_PORT.
LOOM_PUBLIC_ADDR=

# 1 = не спрашивать внешний сервис о публичном IP (закрытый контур)
LOOM_SKIP_IP_LOOKUP=

# --- ДОСТУП ------------------------------------------------------------------
# Токен для /admin/* и админ-панели (генерируется init_env.sh).
# Пусто = админка открыта всем, кто видит порт.
LOOM_ADMIN_TOKEN=

# Пароль Postgres (каталог/биллинг)
LOOM_PG_PASSWORD=loom

# Мастер-токен воркеров вместо join-ключей (dev). Обычно не нужен.
LOOM_NODE_TOKEN=

# --- МОДЕЛИ ------------------------------------------------------------------
# Каталог, загружаемый при старте (файлы в configs/).
# Модели также добавляются на лету в админ-панели по HF-имени.
LOOM_CATALOG=catalog-qwen3-8b.json

# Токен HuggingFace для приватных/gated моделей
HF_TOKEN=

# Сколько токенов генерировать, если запрос не указал max_tokens.
# Reasoning-модели (Qwen3) тратят первые сотни токенов внутри <think>,
# поэтому маленький лимит обрезает ответ на полуслове.
# Передаётся воркерам через окружение контейнера.
LOOM_MAX_TOKENS_DEFAULT=2048

# --- РАЗМЕЩЕНИЕ МОДЕЛЕЙ ------------------------------------------------------
# Доля VRAM-квоты под веса (остальное — KV-кэш). Выше = больше модель влезает
# на карту, но меньше места под контекст.
# 0.60 по умолчанию; 0.75 — Qwen3-8B влезает в 24 ГБ; 0.85 — предел.
LOOM_PARAM_MEM_RATIO=0.6
LOOM_KVCACHE_MEM_RATIO=0.3

# Пересчёт спроса в реплики: k = demand_qps / это значение
LOOM_QPS_PER_PIPELINE=10

# Периодический проход Resource Broker, сек
LOOM_REBALANCE_S=60

# Сколько секунд без heartbeat = узел отвалился
LOOM_HEARTBEAT_TIMEOUT_S=45

# --- ЗАПУСК БЭКЕНДОВ ---------------------------------------------------------
# Холодный старт качает весь чекпоинт (десятки ГБ) — это минуты, а не секунды.
# Сколько ждать ответа на StartServing, прежде чем считать попытку неудачной.
LOOM_START_TIMEOUT_S=3600

# Сколько секунд после выдачи команды не верить телеметрии со статусом failed
# (она ещё описывает предыдущую попытку) — защита от шторма перезапусков.
# Действует только до первого serving: упавший рабочий шард лечится сразу.
LOOM_DEPLOY_GRACE_S=60

# Пауза перед повторной попыткой поставить модель на тот же узел после сбоя.
LOOM_DEPLOY_RETRY_S=300

# --- SLO ---------------------------------------------------------------------
# Как часто проверять SLO, окно p95, минимум запросов для суждения,
# во сколько раз поднять score модели-нарушителя.
LOOM_SLO_CHECK_S=10
LOOM_SLO_WINDOW_S=60
LOOM_SLO_MIN_SAMPLES=10
LOOM_SLO_BOOST=2.0

# --- ТУННЕЛЬ (только для хостов БЕЗ публичного IP) ---------------------------
# docker compose -f docker-compose.prod.yml --profile tunnel up -d
NGROK_AUTHTOKEN=

# --- ПРОЧЕЕ ------------------------------------------------------------------
LOOM_LOG_LEVEL=INFO
